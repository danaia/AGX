# User-space Wayland runtime for ANGI: no kernel, firmware or image. Built into its own output directory
# (scripts/build-wayland.sh) so the running system's packages are untouched, then packaged for the NVMe.
#
# Same CPU, toolchain, C library and graphics stack as agx_rpi5_defconfig, so everything built here
# links against the Mesa/GBM/udev that is already on the device.
BR2_aarch64=y
BR2_cortex_a76=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set

# Graphics stack: V3D through EGL/GLES/GBM and libinput, as in the image. The image uses libudev-zero, but
# Buildroot only lets wlroots build against a full udev provider, so this build tree uses eudev. Its libudev is
# packaged only in Chromium's private library directory. The system keeps libudev-zero.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_DEJAVU_SANS=y
BR2_PACKAGE_DBUS=y

# The Wayland compositor library and protocols (the compositor itself is apps/wayland).
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
# Kept for the first experiments: a kiosk compositor to prove an app runs on this GPU.
BR2_PACKAGE_CAGE=y
# Direct DRM reference session for testing independent Wayland clients.
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
# BR2_PACKAGE_WESTON_SHELL_FULLSCREEN is not set
# BR2_PACKAGE_WESTON_SHELL_IVI is not set
# BR2_PACKAGE_WESTON_SHELL_KIOSK is not set
# BR2_PACKAGE_WESTON_SCREENSHARE is not set
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_SEATD_BUILTIN=y
# WayVNC uses Jansson for its local control protocol.
BR2_PACKAGE_JANSSON=y
# Small Wayland test clients for the first on-device runs: a terminal and wayland-info.
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_GENERATE_LOCALE="C.UTF-8"
BR2_ENABLE_LOCALE_WHITELIST="C C.utf8 en_US"

# Libraries Chromium links against (the 18 missing on the device, plus what they pull in). X11 client
# libraries are linked by Chromium even when it runs on Wayland; no X server is built.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_LIBXCB=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXFIXES=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_LIBNSS=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_PANGO=y
BR2_PACKAGE_CUPS=y
BR2_PACKAGE_AT_SPI2_CORE=y
