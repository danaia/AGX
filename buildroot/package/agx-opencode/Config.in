config BR2_PACKAGE_AGX_OPENCODE
	bool "OpenCode ARM64 CLI for ANGI"
	depends on BR2_aarch64
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_BASH
	select BR2_PACKAGE_GIT
	select BR2_PACKAGE_RIPGREP
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  Pinned official OpenCode terminal coding agent, with Git and ripgrep.
	  User data and caches are stored privately on mounted NVMe.
