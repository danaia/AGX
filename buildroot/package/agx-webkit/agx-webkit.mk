################################################################################
# WPEPlatform engine used by ANGI's on-demand embedded browser.
################################################################################
AGX_WEBKIT_VERSION = 2.54.2
AGX_WEBKIT_SITE = https://wpewebkit.org/releases
AGX_WEBKIT_SOURCE = wpewebkit-$(AGX_WEBKIT_VERSION).tar.xz
AGX_WEBKIT_INSTALL_STAGING = YES
AGX_WEBKIT_LICENSE = LGPL-2.1+, BSD-2-Clause
AGX_WEBKIT_LICENSE_FILES = Source/WebCore/LICENSE-APPLE Source/WebCore/LICENSE-LGPL-2.1
AGX_WEBKIT_CPE_ID_VENDOR = wpewebkit
AGX_WEBKIT_CPE_ID_PRODUCT = wpe_webkit
AGX_WEBKIT_CMAKE_BACKEND = ninja
AGX_WEBKIT_DEPENDENCIES = host-gperf host-python3 host-ruby host-unifdef \
	fontconfig freetype harfbuzz icu jpeg libepoxy libgcrypt libgles \
	libsoup3 libtasn1 libxml2 libpng sqlite webp woff2 libdrm libgbm \
	libinput libxkbcommon libudev libseccomp bubblewrap xdg-dbus-proxy \
	glib-networking ca-certificates shared-mime-info
AGX_WEBKIT_CONF_ENV = WK_USE_CCACHE=NO
AGX_WEBKIT_BUILD_ENV = WK_USE_CCACHE=NO
AGX_WEBKIT_CONF_OPTS = \
	-DPORT=WPE -DCMAKE_BUILD_TYPE=Release \
	-DENABLE_WPE_PLATFORM=ON -DENABLE_WPE_PLATFORM_HEADLESS=ON \
	-DENABLE_WPE_PLATFORM_DRM=ON -DENABLE_WPE_PLATFORM_WAYLAND=OFF \
	-DENABLE_WPE_LEGACY_API=OFF -DENABLE_WPE_QT_API=OFF -DENABLE_COG=OFF \
	-DENABLE_BUBBLEWRAP_SANDBOX=ON \
	-DBWRAP_EXECUTABLE=/usr/bin/bwrap -DDBUS_PROXY_EXECUTABLE=/usr/bin/xdg-dbus-proxy \
	-DENABLE_API_TESTS=OFF -DENABLE_DOCUMENTATION=OFF -DENABLE_INTROSPECTION=OFF \
	-DENABLE_XSLT=OFF -DENABLE_MINIBROWSER=OFF -DENABLE_WEBDRIVER=OFF -DENABLE_GAMEPAD=OFF \
	-DENABLE_VIDEO=OFF -DENABLE_WEB_AUDIO=OFF -DENABLE_WEB_CODECS=OFF \
	-DENABLE_MEDIA_STREAM=OFF -DENABLE_WEB_RTC=OFF -DENABLE_WEBXR=OFF \
	-DENABLE_SPEECH_SYNTHESIS=OFF -DENABLE_SPELLCHECK=OFF -DENABLE_JOURNALD_LOG=OFF \
	-DUSE_ATK=OFF -DUSE_LIBHYPHEN=OFF -DUSE_AVIF=OFF -DUSE_JPEGXL=OFF \
	-DUSE_LCMS=OFF -DUSE_LIBBACKTRACE=OFF -DUSE_SYSPROF_CAPTURE=OFF \
	-DUSE_GSTREAMER=OFF -DUSE_GSTREAMER_GL=OFF -DUSE_VULKAN=OFF -DUSE_WOFF2=ON \
	-DUSE_SKIA=ON -DUSE_LIBDRM=ON -DUSE_GBM=ON \
	-DUSER_AGENT_BRANDING=ANGI
$(eval $(cmake-package))
