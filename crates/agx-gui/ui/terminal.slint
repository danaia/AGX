// Native terminal chrome and coalesced styled glyph runs. No web engine required.
import { Theme } from "data.slint";
import { LineEdit } from "std-widgets.slint";
export struct TerminalRun { col: int, cells: int, text: string, fg: color, bg: color, bold: bool, italic: bool, underline: bool, strike: bool }
export struct TerminalRow { runs: [TerminalRun] }
export global Terminal {
    in-out property <[TerminalRow]> rows;
    in-out property <[string]> tabs;
    in-out property <int> active-tab;
    in-out property <string> title: "Terminal";
    in-out property <string> status: "Opening shell…";
    in-out property <string> error;
    in-out property <string> clipboard;
    in-out property <float> font-size: 14;
    in-out property <int> cursor-col;
    in-out property <int> cursor-row;
    in-out property <bool> cursor-visible;
    in-out property <bool> focused;
    in-out property <bool> search-visible;
    in-out property <string> query;
    in-out property <int> copy-serial;
    in-out property <int> paste-serial;
    in-out property <int> search-serial;
    callback action(int, int);
    callback paste(string);
    callback search(string, bool);
}
component Tool inherits Rectangle {
    in property <string> label;
    in property <int> action;
    width: 28px; height: 26px; border-radius: 4px;
    background: hover.has-hover ? Theme.bg-light : transparent;
    if root.action == 5: Image { x: 6px; y: 5px; width: 16px; height: 16px; source: @image-url("icons/apps/search.svg"); colorize: Theme.fg; }
    if root.action != 5: Text { text: root.label; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; font-size: 15px; }
    hover := TouchArea { clicked => { Terminal.action(root.action, 0); } }
}
export component TerminalPanel inherits Rectangle {
    in property <bool> active;
    property <length> cw: Terminal.font-size * 0.6px;
    property <length> ch: ceil(Terminal.font-size * 1.36) * 1px;
    property <int> copy-request: Terminal.copy-serial;
    property <int> paste-request: Terminal.paste-serial;
    changed copy-request => { clipboard.select-all(); clipboard.copy(); }
    changed paste-request => { clipboard.text = ""; clipboard.paste(); Terminal.paste(clipboard.text); }
    background: #11141c; clip: true;
    Rectangle {
        x: 0; y: 0; height: 34px; width: parent.width; background: Theme.bg-dark;
        for label[index] in Terminal.tabs: Rectangle {
            property <length> tab-width: min(180px, max(1px, (parent.width - 108px) / max(1,Terminal.tabs.length)));
            x: 4px + index * self.tab-width; y: 4px;
            width: self.tab-width - 3px; height: 26px;
            background: index == Terminal.active-tab ? Theme.bg-light : transparent;
            border-radius: 4px;
            Text { x: 8px; width: parent.width - 28px; text: parent.width < 60px ? "" + (index + 1) : label; overflow: elide; color: index == Terminal.active-tab ? Theme.accent : Theme.fg-dim; vertical-alignment: center; font-size: 12px; }
            if self.width > 50px: Text { x: parent.width - 20px; width: 20px; text: "×"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
        }
        Tool { x: parent.width - 96px; y: 4px; label: "+"; action: 0; }
        Tool { x: parent.width - 64px; y: 4px; label: "⌕"; action: 5; }
        Tool { x: parent.width - 32px; y: 4px; label: "↓"; action: 6; }
    }

    if Terminal.search-visible: Rectangle {
        y: 34px; height: 36px; width: parent.width; background: Theme.bg-light;
        property <int> focus-request: Terminal.search-serial;
        changed focus-request => { query.focus(); }
        HorizontalLayout {
            padding: 3px; spacing: 3px;
            query := LineEdit {
                text <=> Terminal.query; placeholder-text: "Search scrollback (regular expression)";
                accepted => { Terminal.search(self.text,false); }
                init => { self.focus(); }
            }
            Tool { label: "↑"; action: 8; }
            Tool { label: "↓"; action: 9; }
            Tool { label: "×"; action: 5; }
        }
    }
    area := Rectangle {
        x: 8px; y: Terminal.search-visible ? 78px : 42px;
        width: parent.width - 16px; height: parent.height - self.y - 26px;
        clip: true;
        for row[y] in Terminal.rows: Rectangle {
            y: y * root.ch; height: root.ch; width: parent.width;
            for run in row.runs: Rectangle {
                x: run.col * root.cw; width: run.cells * root.cw; height: root.ch;
                background: run.bg;
                Text { text: run.text; color: run.fg; font-family: "JetBrainsMono Nerd Font"; font-size: Terminal.font-size * 1px; font-weight: run.bold ? 700 : 400; font-italic: run.italic; vertical-alignment: center; }
                if run.underline: Rectangle { y: parent.height - 2px; height: 1px; width: parent.width; background: run.fg; }
                if run.strike: Rectangle { y: parent.height / 2; height: 1px; width: parent.width; background: run.fg; }
            }
        }
        if Terminal.cursor-visible: Rectangle {
            x: Terminal.cursor-col * root.cw; y: Terminal.cursor-row * root.ch;
            width: root.cw; height: root.ch; border-width: 1px; border-color: Theme.accent;
            background: root.active ? #b8f66c35 : transparent;
        }
        if Terminal.error != "": Text { text: Terminal.error; color: Theme.red; wrap: word-wrap; }
    }
    Text {
        x: 8px; y: parent.height - 23px; width: parent.width - 16px; height: 20px;
        text: Terminal.status; color: Theme.muted; font-size: 10px; overflow: elide; vertical-alignment: center;
    }
    clipboard := TextInput { visible: false; text <=> Terminal.clipboard; }
    function copy() { clipboard.select-all(); clipboard.copy(); }
    function paste() { clipboard.text = ""; clipboard.paste(); Terminal.paste(clipboard.text); }
}
