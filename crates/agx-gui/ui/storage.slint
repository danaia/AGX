import { Theme } from "data.slint";
import { DesktopInput } from "desktop-input.slint";
import { DriveMount } from "drive-mount.slint";
import { ScrollView } from "std-widgets.slint";
import { HoverDwell } from "hover-tip.slint";

export struct StorageCell { tint: color, path: string, detail: string }
export struct StorageTrashRow { name: string, location: string, size: string }
export global StorageView {
    in-out property <bool> empty-confirming: false;
    callback empty-trash();
    in property <[StorageTrashRow]> trash-items;
    in property <string> trash-message;
    in property <bool> trash-loading;
    in property <bool> selected-trashed;
    callback select-trash(int);
    callback restore-file();
    callback restore-trash(int);
    in property <int> category: 0;
    callback select-category(int);
    in property <[StorageCell]> sd-cells;
    in property <[StorageCell]> nvme-cells;
    in property <string> sd-summary: "Scanning…";
    in property <string> nvme-summary: "Scanning…";
    in property <string> sd-status: "Reading mounted filesystems";
    in property <string> nvme-status: "Reading mounted filesystems";
    in property <string> selected-path;
    in property <string> selected-detail;
    in property <string> message;
    in property <int> risk-level: 1;
    in property <string> risk-label: "Medium risk";
    in property <string> risk-reason: "Check that you no longer need this file or have another copy.";
    in property <bool> busy: false;
    in-out property <bool> selected-open: false;
    in-out property <bool> confirming: false;
    callback select-file(int, int);
    callback delete-file();
    callback refresh-files();
    callback check-cache();
    callback clear-cache();
    callback close-cache();
    in property <bool> cache-open: false;
    in property <bool> cache-ready: false;
    in property <bool> refreshing: false;
}

export component StorageMap inherits Rectangle {
    in property <string> label;
    in property <int> drive;
    in property <string> summary;
    in property <string> status;
    in property <[StorageCell]> cells;
    in property <int> cursor;
    in property <bool> hide-cursor;
    callback pointer(int, int, length, length, bool, bool, bool, bool);
    callback pointer-moved(length, length);
    private property <bool> mount-available: root.drive == 1 && root.summary == "Not mounted";
    private property <bool> window-gesture: false;
    private property <int> columns: max(8, min(64, floor(self.width / 14px)));
    private property <length> cell-size: self.width / root.columns;
    private property <int> rows: max(2, ceil(root.cells.length / root.columns));
    private property <int> raw-index: floor(grid-input.mouse-y / root.cell-size) * root.columns + floor(grid-input.mouse-x / root.cell-size);
    out property <int> hovered-index: grid-input.has-hover && root.raw-index >= 0 && root.raw-index < root.cells.length ? root.raw-index : -1;
    out property <string> hover-path: root.hovered-index >= 0 ? root.cells[root.hovered-index].path : "";
    out property <string> hover-detail: root.hovered-index >= 0 ? root.cells[root.hovered-index].detail : "";
    height: 40px + root.rows * root.cell-size;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            height: 16px;
            Text { text: root.label; color: #c5a38b; font-size: 12px; font-weight: 700; }
            Text { text: root.summary; color: Theme.fg-dim; font-size: 11px; horizontal-alignment: right; overflow: elide; }
        }
        grid := Rectangle {
            height: root.rows * root.cell-size;
            background: #292021;
            for cell[i] in root.cells: Rectangle {
                x: mod(i, root.columns) * root.cell-size;
                y: floor(i / root.columns) * root.cell-size;
                width: root.cell-size - 1px;
                height: root.cell-size - 1px;
                background: cell.tint;
                animate x, y { duration: 220ms; easing: ease-in-out; }
                border-width: root.hovered-index == i ? 1px : 0px;
                border-color: #ead0b7;
                accessible-role: button;
                accessible-label: cell.path + " · " + cell.detail;
            }
            if root.cells.length == 0 && !root.mount-available: Text {
                text: root.summary == "Scanning…" ? "Reading file sizes…" : root.summary == "Not mounted" ? "Not mounted" : "No removable files in this category";
                color: #947a6d; font-size: 11px;
                vertical-alignment: center; horizontal-alignment: center;
            }
            grid-input := DesktopInput {
                forward-scroll: false;
                clicked => { if !root.window-gesture && root.hovered-index >= 0 { StorageView.select-file(root.drive, root.hovered-index); } }
                cursor: root.hovered-index >= 0 ? 6 : root.cursor;
                hide-cursor: root.hide-cursor;
                pointer(k, b, x, y, c, a, s, m) => {
                    if k == 0 { root.window-gesture = b != 0 || c || a || s || m; }
                    // Plain tile clicks open details without rebuilding the window
                    // stack on press. Modified gestures still reach the desktop.
                    if root.window-gesture || k == 2 || k == 3 { root.pointer(k, b, x, y, c, a, s, m); }
                }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
            if root.mount-available: link := FocusScope {
                x: (parent.width - self.width) / 2;
                width: min(200px, parent.width);
                height: parent.height;
                accessible-role: button;
                accessible-label: "Mount External Drive";
                accessible-action-default => { DriveMount.show-picker(); }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        DriveMount.show-picker();
                        return accept;
                    }
                    reject
                }
                Rectangle {
                    border-width: link.has-focus ? 1px : 0px;
                    border-color: Theme.accent;
                    Text {
                        text: "Mount External Drive";
                        color: mount-link.has-hover ? Theme.fg-bright : Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 11px;
                    }
                }
                mount-link := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    moved => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                    clicked => { link.focus(); DriveMount.show-picker(); }
                }
            }
        }
        Text { height: 16px; text: root.status; color: Theme.fg-dim; font-size: 10px; overflow: elide; }
    }
}

export component StorageCategories inherits ScrollView {
    in property <bool> hide-cursor;
    callback pointer-moved(length, length);
    out property <string> hint-text;
    out property <length> hint-x;
    height: strip.preferred-width > self.width ? 46px : 34px;
    content-width: max(self.width, strip.preferred-width);
    content-height: 32px;
    horizontal-scrollbar-policy: as-needed;
    vertical-scrollbar-policy: always-off;
    strip := HorizontalLayout {
        height: 32px;
        spacing: 20px;
        alignment: start;
        for tab[index] in [
            { label: "All files", icon: @image-url("icons/storage-categories/all.svg") },
            { label: "Apps & Games", icon: @image-url("icons/apps/applications.svg") },
            { label: "Media", icon: @image-url("icons/storage-categories/media.svg") },
            { label: "Downloads", icon: @image-url("icons/storage-categories/downloads.svg") },
            { label: "Documents", icon: @image-url("icons/storage-categories/documents.svg") },
            { label: "Cache", icon: @image-url("icons/apps/storage.svg") },
            { label: "Other files", icon: @image-url("icons/storage-categories/other.svg") },
            { label: "Trash", icon: @image-url("icons/storage-categories/trash.svg") },
        ]: row := Rectangle {
            width: 28px;
            horizontal-stretch: 0;
            height: 31px;
            background: keys.has-focus ? Theme.bg-light : transparent;
            accessible-role: button;
            accessible-label: tab.label;
            accessible-action-default => { dwell.dismiss(); StorageView.select-category(index); }
            keys := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == " " {
                        dwell.dismiss();
                        StorageView.select-category(index);
                        return accept;
                    }
                    reject
                }
                pointer := TouchArea {
                    mouse-cursor: root.hide-cursor ? MouseCursor.none : MouseCursor.pointer;
                    moved => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                    clicked => { dwell.dismiss(); keys.focus(); StorageView.select-category(index); }
                }
            }
            dwell := HoverDwell {
                hovered: pointer.has-hover;
                changed ready => {
                    if self.ready {
                        root.hint-text = tab.label;
                        root.hint-x = row.absolute-position.x - root.absolute-position.x;
                    } else if root.hint-text == tab.label {
                        root.hint-text = "";
                    }
                }
            }
            Image {
                width: 19px;
                height: 19px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: tab.icon;
                colorize: StorageView.category == index || pointer.has-hover ? Theme.accent : Theme.fg;
            }
            if StorageView.category == index: Rectangle {
                y: parent.height - 2px; height: 2px; background: Theme.accent;
            }
        }
    }
}
