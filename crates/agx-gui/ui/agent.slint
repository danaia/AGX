import { Theme } from "data.slint";
import { LineEdit, Button } from "std-widgets.slint";

import { AgentProviders, CardModels, ProviderCards, ProviderPanel } from "agent-providers.slint";
import { AgentScope, ModeSwitch, ProjectRow, ScopeTip } from "agent-scope.slint";
export { AgentProviders, CardModels, AgentScope }

export global AgentAngie {
    callback activate();
    callback submit(string);
}

export component AgentPanel inherits Rectangle {
    in property <bool> active;
    callback pointer-moved(length, length);
    background: Theme.bg-dark;
    changed active => { if (root.active && !AgentProviders.open) { prompt.focus(); } }
    init => { if (root.active && !AgentProviders.open) { prompt.focus(); } }
    TouchArea {
        changed mouse-x => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        changed mouse-y => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { AgentAngie.activate(); } }
    }
    content := Rectangle {
    x: 0px; y: 0px;
    width: AgentProviders.open ? max(0px, parent.width - min(440px, parent.width * 0.48)) : parent.width;
    height: parent.height;
    VerticalLayout {
        x: max(20px, (content.width - 660px) / 2);
        y: max(24px, (content.height - 390px) / 2);
        width: min(660px, content.width - 40px);
        height: 220px + (AgentScope.mode == "project" ? 48px + (AgentScope.error != "" ? 22px : 0px) : 0px);
        spacing: 16px;
        // Rows below the prompt appear and disappear; keep everything above them where it is.
        alignment: start;
        Text { text: "AGENT ANGIE"; color: Theme.accent; font-size: 13px; font-weight: 700; }
        Text { text: "What do you want to build today?"; color: Theme.fg-bright; font-size: 26px; font-weight: 700; wrap: word-wrap; }
        Text { text: "Describe your idea and Agent Angie will get to work."; color: Theme.fg; font-size: 13px; wrap: word-wrap; }
        prompt := LineEdit {
            placeholder-text: "Describe what you want to build…";
            accepted => { if (self.text != "" && AgentScope.ready) { AgentAngie.submit(self.text); } }
        }
        HorizontalLayout {
            spacing: 12px;
            scope-switch := ModeSwitch { y: 2px; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Start building"; enabled: prompt.text != "" && AgentScope.ready; clicked => { AgentAngie.submit(prompt.text); } }
        }
        if AgentScope.mode == "project": ProjectRow { }
    }
    ProviderCards {
        x: 24px; y: max(270px, content.height - 176px);
        width: max(0px, content.width - 48px); height: 150px;
    }
    // Last, so it draws over the rows below the switch.
    ScopeTip {
        hint: scope-switch.hint;
        x: scope-switch.absolute-position.x - content.absolute-position.x;
        y: scope-switch.absolute-position.y - content.absolute-position.y + scope-switch.height + 8px;
    }
    }
    if AgentProviders.open: ProviderPanel {
        x: content.width; width: parent.width - content.width; height: parent.height;
    }
}
