// AGX desktop shell. The tiling engine lives in Rust (src/wm.rs); this file
// draws what it places and forwards raw keyboard and pointer input to it.
import { Theme, Sys, NetRow, HwRow, MenuRow, Win } from "data.slint";
import { OverviewPanel, CpuPanel, MemoryPanel, NetworkPanel, HardwarePanel, ServicesPanel, SystemPanel } from "panels.slint";
import { Cursor } from "cursor.slint";
import { CursorPreviewWindow } from "cursor-preview.slint";
export { CursorPreviewWindow }
import { LineEdit, Button } from "std-widgets.slint";
export { Theme, Sys, NetRow, HwRow, MenuRow, Win }

// Frame metrics mirror wm.rs: header 28px, buttons 26px wide, border 2px.
component WindowFrame inherits Rectangle {
    in property <Win> win;
    in property <bool> dragging;
    animate x, y, width, height { duration: root.dragging ? 0ms : 110ms; easing: ease-out; }
    background: win.target ? @linear-gradient(45deg, Theme.magenta, Theme.yellow)
        : win.focused ? @linear-gradient(45deg, #33ccff, #00ff99)
        : @linear-gradient(45deg, Theme.muted, Theme.muted);
    Rectangle {
        x: Theme.border;
        y: Theme.border;
        width: parent.width - 2 * Theme.border;
        height: parent.height - 2 * Theme.border;
        background: Theme.bg;
        VerticalLayout {
            Rectangle {
                height: 26px;
                background: win.focused ? Theme.bg-light : Theme.bg-dark;
                HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        text: win.title;
                        color: win.focused ? Theme.accent : Theme.fg-dim;
                        font-weight: 700;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text { text: win.floating ? "󰖲" : "󰖯"; color: Theme.fg-dim; width: 26px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "󰊓"; color: Theme.fg-dim; width: 26px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "󰖭"; color: win.focused ? Theme.red : Theme.fg-dim; width: 26px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                if win.kind == 0: OverviewPanel { }
                if win.kind == 1: CpuPanel { }
                if win.kind == 2: MemoryPanel { }
                if win.kind == 3: NetworkPanel { }
                if win.kind == 4: HardwarePanel { }
                if win.kind == 5: ServicesPanel { }
                if win.kind == 6: SystemPanel { }
            }
        }
    }
}

component WorkspaceButton inherits Rectangle {
    in property <int> index;
    in property <bool> active;
    in property <bool> occupied;
    width: 30px;
    background: root.active ? Theme.accent : transparent;
    Text {
        text: root.index + 1;
        color: root.active ? Theme.bg-dark : root.occupied ? Theme.fg : Theme.muted;
        font-weight: root.occupied || root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component LoginWindow inherits Window {
    title: "ANGI · Sign in";
    background: Theme.bg-dark;
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: 16px;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    forward-focus: username;
    in property <bool> busy: false;
    in property <bool> draw-cursor: false;
    in property <string> error-text;
    callback sign-in(string, string);
    callback authenticated(string);
    function submit() {
        if (!root.busy) {
            root.sign-in(username.text, password.text);
            password.text = "";
        }
    }
    tracker := TouchArea {
        width: parent.width;
        height: parent.height;
        Rectangle {
            width: min(440px, parent.width - 48px);
            height: 366px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 30px;
                spacing: 14px;
                Text { text: "ANGI"; color: Theme.accent; font-size: 38px; font-weight: 700; }
                Text { text: "Sign in to your desktop"; color: Theme.fg; }
                username := LineEdit {
                    placeholder-text: "Username";
                    enabled: !root.busy;
                    accepted => { password.focus(); }
                }
                password := LineEdit {
                    placeholder-text: "Password";
                    input-type: InputType.password;
                    enabled: !root.busy;
                    accepted => { root.submit(); }
                }
                Button {
                    text: root.busy ? "Signing in…" : "Sign in";
                    enabled: !root.busy;
                    clicked => { root.submit(); }
                }
                Text { text: root.error-text; color: Theme.red; wrap: word-wrap; font-size: 12px; min-height: 32px; }
            }
        }
    }
    if root.draw-cursor: Cursor { x: tracker.mouse-x; y: tracker.mouse-y; shape: 0; }
}

export component AppWindow inherits Window {
    title: "ANGI";
    background: Theme.bg;
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: Theme.text;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    forward-focus: root-keys;

    in property <[Win]> wins: [];
    in property <[bool]> ws-occupied: [false, false, false, false, false];
    in property <int> workspace: 0;
    in property <string> layout-name: "tiled";
    in property <string> focus-title: "";
    in property <string> mod-name: "Super";
    in property <string> clock: "";
    in property <string> toast: "";
    in property <bool> screen-full: false;
    in property <bool> dragging: false;
    in property <int> cursor: 0;
    in property <bool> draw-cursor: false;
    in property <bool> resize-cursor-overlay: false;
    in-out property <length> cursor-x;
    in-out property <length> cursor-y;
    in-out property <bool> cursor-seen: false;
    in property <bool> ghost-visible: false;
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-w;
    in property <length> ghost-h;

    in-out property <bool> menu-open: false;
    in-out property <int> menu-index: 0;
    in property <[MenuRow]> menu-rows: [];
    in-out property <string> confirm-text: "";
    in-out property <bool> session-open: false;
    in-out property <int> session-index: 0;
    property <bool> custom-resize-cursor: root.resize-cursor-overlay
        && root.cursor >= 1 && root.cursor <= 5 && !root.menu-open && !root.session-open && root.confirm-text == "";

    callback key(string, bool, bool, bool, bool) -> bool;
    callback pointer(int, int, length, length, bool, bool, bool, bool);
    callback scroll(float, bool, bool, bool, bool);
    callback resized(length, length);
    callback menu-query(string);
    callback menu-accept(int);
    callback confirm(bool);
    callback session-action(int);

    function track-cursor(x: length, y: length) {
        root.cursor-x = x;
        root.cursor-y = y;
        root.cursor-seen = true;
    }

    pure function key-name(t: string) -> string {
        t == Key.LeftArrow ? "left" : t == Key.RightArrow ? "right" : t == Key.UpArrow ? "up"
        : t == Key.DownArrow ? "down" : (t == Key.Tab || t == Key.Backtab) ? "tab" : t == " " ? "space"
        : t == Key.Escape ? "escape" : t == Key.Return ? "enter" : t.to-lowercase()
    }

    root-keys := FocusScope {
        key-pressed(e) => {
            if (root.session-open) {
                if (e.text == Key.Escape) { root.session-open = false; }
                if (e.text == Key.DownArrow) { root.session-index = mod(root.session-index + 1, 4); }
                if (e.text == Key.UpArrow) { root.session-index = mod(root.session-index + 3, 4); }
                if (e.text == Key.Return) { root.session-open = false; root.session-action(root.session-index); }
                return accept;
            }
            if (root.confirm-text != "") {
                if (e.text == Key.Return) { root.confirm(true); }
                if (e.text == Key.Escape) { root.confirm(false); }
                return accept;
            }
            if (root.key(root.key-name(e.text), e.modifiers.control, e.modifiers.alt, e.modifiers.shift || e.text == Key.Backtab, e.modifiers.meta)) {
                return accept;
            }
            reject
        }

        // Desk: windows, drag ghost, and the pointer layer that drives the engine.
        Rectangle {
            width: parent.width;
            height: parent.height;
            changed width => { root.resized(self.width, self.height); }
            changed height => { root.resized(self.width, self.height); }
            init => { root.resized(self.width, self.height); }

            for w in root.wins: WindowFrame {
                x: w.x;
                y: w.y;
                width: w.w;
                height: w.h;
                win: w;
                dragging: root.dragging;
            }
            if root.ghost-visible: Rectangle {
                x: root.ghost-x;
                y: root.ghost-y;
                width: root.ghost-w;
                height: root.ghost-h;
                border-width: 2px;
                border-color: Theme.accent;
                background: #7aa2f733;
            }
            touch := TouchArea {
                // LinuxKMS maps built-in resize shapes to its default arrow.
                // Hide it while AGX draws the directional resize/move overlay.
                mouse-cursor: root.draw-cursor || root.custom-resize-cursor
                    ? MouseCursor.none
                    : root.cursor == 1 ? MouseCursor.move : root.cursor == 2 ? MouseCursor.col-resize
                    : root.cursor == 3 ? MouseCursor.row-resize : root.cursor == 4 ? MouseCursor.nwse-resize
                    : root.cursor == 5 ? MouseCursor.nesw-resize
                    : root.cursor == 6 ? MouseCursor.pointer : MouseCursor.default;
                pointer-event(e) => {
                    root.cursor-x = self.mouse-x;
                    root.cursor-y = self.mouse-y;
                    root.cursor-seen = true;
                    root.pointer(
                        e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : e.kind == PointerEventKind.cancel ? 3 : 2,
                        e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : 2,
                        self.mouse-x, self.mouse-y,
                        e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                }
                moved => {
                    root.cursor-seen = true;
                    root.cursor-x = self.mouse-x;
                    root.cursor-y = self.mouse-y;
                    root.pointer(2, 3, self.mouse-x, self.mouse-y, false, false, false, false);
                }
                scroll-event(e) => {
                    root.scroll(e.delta-y / 1px, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                    accept
                }
            }
        }

        // Top bar (hidden while a window is fullscreen).
        if !root.screen-full: Rectangle {
            y: 0;
            height: 34px;
            background: Theme.bg-dark;
            HorizontalLayout {
                padding-left: Theme.gap-out;
                padding-right: Theme.gap-out;
                spacing: 2px;
                for occupied[i] in root.ws-occupied: WorkspaceButton {
                    index: i;
                    active: root.workspace == i;
                    occupied: occupied;
                }
                Text { text: "  " + root.layout-name; color: Theme.magenta; vertical-alignment: center; }
                Text { text: "  " + root.focus-title; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: "󰍛 \{Math.round(Sys.cpu-percent)}%"; color: Theme.cyan; vertical-alignment: center; }
                Text { text: "  󰘚 \{Math.round(Sys.mem-percent)}%"; color: Theme.magenta; vertical-alignment: center; }
                Text { text: "  󰛳 " + Sys.primary-ip; color: Theme.green; vertical-alignment: center; max-width: 180px; overflow: elide; }
                Rectangle {
                    width: 48px;
                    background: session-button.has-hover || root.session-open ? Theme.bg-light : transparent;
                    accessible-role: button;
                    accessible-label: "Session menu";
                    Text { text: " ⌄"; color: Theme.fg-bright; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    session-button := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => { root.track-cursor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                        moved => { root.track-cursor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                        clicked => {
                            root.session-open = !root.session-open;
                            root.session-index = 0;
                            root.menu-open = false;
                            root-keys.focus();
                        }
                    }
                }
            }
            Text {
                text: root.clock;
                color: Theme.fg-bright;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Hint line.
        if !root.screen-full: Rectangle {
            y: parent.height - 26px;
            height: 26px;
            background: Theme.bg-dark;
            HorizontalLayout {
                padding-left: Theme.gap-out;
                padding-right: Theme.gap-out;
                spacing: 18px;
                Text {
                    text: root.toast != "" ? root.toast
                        : "\{root.mod-name}+arrows focus   +Shift swap   +Q close   +T float   +F full   +L window mode   +1-5 workspace   / menu";
                    color: root.toast != "" ? Theme.yellow : Theme.fg-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Menu overlay: workspaces, closed panels, window actions, power.
        if root.menu-open: Rectangle {
            background: #00000099;
            init => { menu-input.focus(); }
            // Rows start 116px down (panel y 70, border 2, padding 12, input 24, gap 8); pitch 36px.
            menu-touch := TouchArea {
                property <length> panel-w: min(560px, root.width - 40px);
                property <bool> in-panel: self.mouse-x >= (root.width - panel-w) / 2 && self.mouse-x <= (root.width + panel-w) / 2;
                property <int> hit-row: Math.floor((self.mouse-y - 116px) / 36px);
                pointer-event(e) => {
                    root.cursor-x = self.mouse-x;
                    root.cursor-y = self.mouse-y;
                    root.cursor-seen = true;
                    if (self.in-panel && self.hit-row >= 0 && self.hit-row < root.menu-rows.length) {
                        root.menu-index = self.hit-row;
                    }
                }
                clicked => {
                    if (self.in-panel && self.hit-row >= 0 && self.hit-row < root.menu-rows.length) {
                        root.menu-open = false;
                        root-keys.focus();
                        root.menu-accept(self.hit-row);
                    } else if (!self.in-panel || self.mouse-y < 70px) {
                        root.menu-open = false;
                        root-keys.focus();
                    }
                }
            }
            Rectangle {
                width: min(560px, parent.width - 40px);
                height: 64px + min(root.menu-rows.length, 9) * 36px;
                y: 70px;
                background: @linear-gradient(45deg, #33ccff, #00ff99);
                Rectangle {
                    x: Theme.border;
                    y: Theme.border;
                    width: parent.width - 2 * Theme.border;
                    height: parent.height - 2 * Theme.border;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 8px;
                            Text { text: "󰍉"; color: Theme.accent; vertical-alignment: center; }
                            menu-input := TextInput {
                                color: Theme.fg-bright;
                                font-size: 15px;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                edited => { root.menu-index = 0; root.menu-query(self.text); }
                                accepted => { root.menu-open = false; root-keys.focus(); root.menu-accept(root.menu-index); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) { root.menu-open = false; root-keys.focus(); return accept; }
                                    if (e.text == Key.DownArrow) { root.menu-index = min(root.menu-index + 1, root.menu-rows.length - 1); return accept; }
                                    if (e.text == Key.UpArrow) { root.menu-index = max(root.menu-index - 1, 0); return accept; }
                                    reject
                                }
                            }
                        }
                        for row[i] in root.menu-rows: Rectangle {
                            height: 28px;
                            background: i == root.menu-index ? Theme.bg-light : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: row.label; color: i == root.menu-index ? Theme.accent : Theme.fg; vertical-alignment: center; }
                                Text { text: row.hint; color: Theme.fg-dim; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // Session dropdown stays separate from the searchable window menu.
        if root.session-open: Rectangle {
            TouchArea {
                pointer-event(e) => { root.track-cursor(self.mouse-x, self.mouse-y); }
                moved => { root.track-cursor(self.mouse-x, self.mouse-y); }
                clicked => { root.session-open = false; root-keys.focus(); }
            }
            Rectangle {
                x: parent.width - self.width - 10px;
                y: 42px;
                width: 238px;
                height: 192px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.muted;
                background: Theme.bg;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    for label[i] in ["Log out", "Enter TUI", "Reboot…", "Shut down…"]: Rectangle {
                        background: row-touch.has-hover || root.session-index == i ? Theme.bg-light : transparent;
                        border-radius: 4px;
                        accessible-role: button;
                        accessible-label: label;
                        Text { x: 12px; text: label; color: i >= 2 ? Theme.red : Theme.fg-bright; font-size: 14px; vertical-alignment: center; }
                        row-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            pointer-event(e) => { root.track-cursor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                            moved => { root.track-cursor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                            clicked => { root.session-open = false; root-keys.focus(); root.session-action(i); }
                        }
                    }
                }
            }
        }

        // Confirmation overlay for disruptive actions.
        if root.confirm-text != "": Rectangle {
            background: #000000bb;
            TouchArea {
                pointer-event(e) => {
                    root.cursor-x = self.mouse-x;
                    root.cursor-y = self.mouse-y;
                    root.cursor-seen = true;
                }
            }
            Rectangle {
                width: min(460px, parent.width - 40px);
                height: 180px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.red;
                Rectangle {
                    x: Theme.border;
                    y: Theme.border;
                    width: parent.width - 2 * Theme.border;
                    height: parent.height - 2 * Theme.border;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: root.confirm-text; color: Theme.fg-bright; wrap: word-wrap; font-weight: 700; }
                        Text { text: "Enter confirms. Esc cancels."; color: Theme.fg-dim; }
                        HorizontalLayout {
                            spacing: 12px;
                            Button { text: "Cancel"; clicked => { root.confirm(false); } }
                            Button { text: "Confirm"; clicked => { root.confirm(true); } }
                        }
                    }
                }
            }
        }

        if (root.draw-cursor || root.custom-resize-cursor) && root.cursor-seen: Cursor {
            x: root.cursor-x;
            y: root.cursor-y;
            shape: root.menu-open || root.confirm-text != "" ? 0 : root.cursor;
        }
    }
}
