import { Theme } from "data.slint";
import { StorageView } from "storage.slint";
import { Button, ScrollView } from "std-widgets.slint";

export component CacheDialog inherits FocusScope {
    callback dismissed;
    callback pointer-moved(length, length);
    init => { close-button.focus(); }
    function close() {
        if !StorageView.busy {
            StorageView.close-cache();
            root.dismissed();
        }
    }
    key-pressed(e) => {
        if e.text == Key.Escape { root.close(); return accept; }
        if e.text == Key.Tab || e.text == Key.Backtab {
            if close-button.has-focus && clear-button.enabled { clear-button.focus(); }
            else { close-button.focus(); }
            return accept;
        }
        reject
    }
    Rectangle {
        background: #00000099;
        TouchArea { moved => { root.pointer-moved(self.mouse-x, self.mouse-y); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 32px);
            height: min(330px, parent.height - 32px);
            background: Theme.bg;
            border-color: StorageView.cache-ready ? Theme.red : Theme.muted;
            border-width: 1px; border-radius: 6px;
            VerticalLayout {
                padding: 20px; spacing: 14px;
                Text {
                    text: StorageView.cache-ready ? "Clear verified cache?" : "OpenCode cache";
                    color: Theme.fg-bright; font-size: 19px; font-weight: 700;
                }
                ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: StorageView.message;
                            color: Theme.fg-bright; font-size: 13px; wrap: word-wrap;
                        }
                        Text {
                            text: "Only verified npm downloads for your account, last modified at least an hour ago, can be cleared. OpenCode may need an internet connection to download them again. Projects, sessions, settings, and installed tools are kept.";
                            color: Theme.fg-dim; font-size: 12px; wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    close-button := Button {
                        text: StorageView.cache-ready ? "Cancel" : "Close";
                        enabled: !StorageView.busy;
                        clicked => { root.close(); }
                    }
                    clear-button := Button {
                        text: "Clear verified cache";
                        enabled: StorageView.cache-ready && !StorageView.busy;
                        clicked => { StorageView.clear-cache(); }
                    }
                }
            }
        }
    }
}
