import { Theme } from "data.slint";
import { Button, LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
export struct CardModels { orchestrator: string, builder: string, tester: string, os: string }
export global AgentProviders {
    in-out property <bool> open;
    in-out property <string> provider: "openai";
    in-out property <bool> connected;
    in-out property <bool> busy;
    in-out property <bool> watching;
    in-out property <string> status;
    in-out property <string> apple-address;
    // LM Studio is reached over Tailscale: its state, and whether sign-in can be offered.
    in-out property <string> tailscale;
    in-out property <bool> tailscale-ready;
    in-out property <bool> tailscale-login;
    in-out property <[string]> models;
    in-out property <string> orchestrator;
    in-out property <string> builder;
    in-out property <string> tester;
    // The model for OS updates: one fast agent, no swarm.
    in-out property <string> os-updates;
    // Cards in display order: Apple Intelligence, OpenAI, LM Studio. Only one service is active.
    out property <[string]> names: ["Apple Intelligence", "OpenAI", "LM Studio"];
    in-out property <[bool]> ready: [false, false, false];
    in-out property <int> active-index: -1;
    // Models saved per card, without the provider prefix, for the card footers.
    // Position of each role's saved model in `models` (-1 when none), for the drawer's dropdowns.
    in-out property <[int]> role-index: [-1, -1, -1, -1];
    in-out property <[CardModels]> card-models: [{ orchestrator: "", builder: "", tester: "", os: "" }, { orchestrator: "", builder: "", tester: "", os: "" }, { orchestrator: "", builder: "", tester: "", os: "" }];
    callback action(int, string);
    callback use-service(string);
    callback save(string, string);
    callback open-link(string);
    public pure function index-of(provider: string) -> int {
        return provider == "apple" ? 0 : provider == "openai" ? 1 : 2;
    }
    public function show(provider: string) {
        self.provider = provider; self.open = true; self.connected = self.ready[self.index-of(provider)];
        self.models = []; self.status = "Checking connection…";
        self.action(0, "");
    }
}
component ActiveLabel inherits Rectangle {
    width: 56px; height: 20px; border-radius: 10px; background: Theme.green;
    Text { text: "ACTIVE"; color: Theme.bg-dark; font-size: 10px; font-weight: 700; }
}
component ModelRow inherits HorizontalLayout {
    in property <string> role;
    in property <string> model;
    in property <bool> in-use;
    alignment: end; spacing: 8px;
    Text { text: root.role; color: Theme.fg-dim; font-size: 10px; vertical-alignment: center; }
    Text { text: root.model == "" ? "default" : root.model; color: root.model == "" || !root.in-use ? Theme.fg-dim : Theme.fg-bright; font-size: 11px; vertical-alignment: center; }
}
// Bottom-right card footer: the models new builds use (dimmed while the service is not in use).
component ModelFooter inherits VerticalLayout {
    in property <CardModels> models;
    in property <bool> in-use;
    spacing: 2px;
    if root.models.orchestrator != "" || root.models.builder != "" || root.models.tester != "" || root.models.os != "": VerticalLayout {
        spacing: 2px;
        ModelRow { role: "OS updates"; model: root.models.os; in-use: root.in-use; }
        ModelRow { role: "orchestrator"; model: root.models.orchestrator; in-use: root.in-use; }
        ModelRow { role: "builder"; model: root.models.builder; in-use: root.in-use; }
        ModelRow { role: "tester"; model: root.models.tester; in-use: root.in-use; }
    }
    if root.models.orchestrator == "" && root.models.builder == "" && root.models.tester == "" && root.models.os == "" && root.in-use: Text {
        text: "Default models"; color: Theme.fg-dim; font-size: 11px; horizontal-alignment: right;
    }
}
component RoleModel inherits VerticalLayout {
    in property <string> role;
    // What the person sees; the role is what is saved.
    in property <string> label;
    in property <string> selected;
    in property <int> index;
    spacing: 6px;
    Text { text: (root.label != "" ? root.label : root.role).to-uppercase(); color: Theme.fg-dim; font-size: 11px; }
    Text { text: root.selected == "" ? "OpenCode default" : root.selected; color: Theme.accent; font-size: 11px; wrap: word-wrap; }
    ComboBox {
        model: AgentProviders.models;
        current-index: root.index;
        enabled: !AgentProviders.busy && AgentProviders.models.length > 0;
        selected(value) => { AgentProviders.save(root.role, value); }
    }
}
export component ProviderCards inherits HorizontalLayout {
    spacing: 16px;
    for title[index] in AgentProviders.names : Rectangle {
        property <bool> in-use: AgentProviders.active-index == index;
        property <bool> ready: AgentProviders.ready[index];
        horizontal-stretch: 1; preferred-width: 100px; min-width: 0px;
        border-width: in-use ? 2px : 1px; border-color: in-use ? Theme.green : hover.has-hover ? Theme.accent : Theme.muted;
        border-radius: 10px; background: Theme.bg-light;
        VerticalLayout {
            padding: 18px; spacing: 10px; alignment: start;
            HorizontalLayout {
                height: 22px;
                Text { text: title; color: Theme.fg-bright; font-size: 16px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                if in-use: ActiveLabel { }
            }
            Text { text: index == 0 ? "Connect Local LLM Server" : index == 1 ? "Sign in with ChatGPT" : "Local model over Tailscale"; color: Theme.fg-dim; font-size: 11px; wrap: word-wrap; }
            Text { text: ready ? "Manage →" : "Set up →"; color: Theme.accent; font-size: 12px; }
        }
        hover := TouchArea { clicked => { AgentProviders.show(index == 0 ? "apple" : index == 1 ? "openai" : "lmstudio"); } }
        // Left footer: the one action for this card.
        if ready && !in-use: Button {
            x: 18px; y: parent.height - self.height - 14px;
            width: 64px; height: 28px; text: "Use"; enabled: !AgentProviders.busy;
            clicked => { AgentProviders.use-service(index == 0 ? "apple" : index == 1 ? "openai" : "lmstudio"); }
        }
        // Right footer: the models saved for this service.
        ModelFooter {
            // Too narrow (the drawer is open, or the window is tiled): the rows would cover the text.
            visible: parent.width >= 330px;
            width: min(parent.width - 36px, 240px); height: self.preferred-height;
            x: parent.width - self.width - 18px; y: parent.height - self.height - 14px;
            models: AgentProviders.card-models[index]; in-use: in-use;
        }
    }
}
export component ProviderPanel inherits Rectangle {
    background: Theme.bg-light;
    clip: true;
    VerticalLayout {
        padding: 22px; spacing: 18px;
        HorizontalLayout {
            spacing: 14px;
            Text { text: AgentProviders.names[AgentProviders.index-of(AgentProviders.provider)]; color: Theme.fg-bright; font-size: 21px; font-weight: 700; }
            if AgentProviders.active-index == AgentProviders.index-of(AgentProviders.provider): VerticalLayout {
                alignment: center; padding-left: 4px;
                ActiveLabel { }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { height: 36px; vertical-stretch: 0; width: 36px; text: "×"; clicked => { AgentProviders.open = false; } }
        }
        ScrollView {
            VerticalLayout {
                alignment: start; spacing: 18px; padding-right: 8px;
                Text { text: AgentProviders.status; color: Theme.fg; font-size: 13px; wrap: word-wrap; }
                if AgentProviders.provider == "apple": VerticalLayout {
                    alignment: start; spacing: 12px;
                    Button { height: 36px; vertical-stretch: 0; text: "Open Local LLM Server in the App Store"; clicked => { AgentProviders.open-link("https://apps.apple.com/us/app/local-llm-server/id6757007308"); } }
                    Text { text: "Use the network address shown by the app, not localhost. Apple Intelligence must be enabled and its model downloaded on the Apple device."; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                    endpoint := LineEdit { height: 36px; vertical-stretch: 0; placeholder-text: "http://your-device-address:port/v1"; text <=> AgentProviders.apple-address; }
                    Button { height: 36px; vertical-stretch: 0; text: "Test and connect"; enabled: !AgentProviders.busy && endpoint.text != ""; clicked => { AgentProviders.action(2, endpoint.text); } }
                }
                if AgentProviders.provider == "openai" && !AgentProviders.connected: VerticalLayout {
                    alignment: start; spacing: 12px;
                    Text { text: "Sign in in the browser window. Once this panel says Connected, you can close the browser. Closing the browser alone does not complete authentication."; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                    Button { height: 36px; vertical-stretch: 0; text: "Sign in with ChatGPT"; enabled: !AgentProviders.busy; clicked => { AgentProviders.action(1, ""); } }
                }
                if AgentProviders.provider == "lmstudio": VerticalLayout {
                    alignment: start; spacing: 12px;
                    Text { text: AgentProviders.tailscale; color: AgentProviders.tailscale-ready ? Theme.green : Theme.yellow; font-size: 12px; wrap: word-wrap; }
                    if AgentProviders.tailscale-login: Button { height: 36px; vertical-stretch: 0; text: "Sign in to Tailscale"; enabled: !AgentProviders.busy; clicked => { AgentProviders.action(5, ""); } }
                    Text { text: "In LM Studio, load a model, start the server and turn on Serve on local network. Then enter that computer's Tailscale name or address."; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                    lm-endpoint := LineEdit { height: 36px; vertical-stretch: 0; placeholder-text: "your-computer or 100.x.y.z:1234"; }
                    Button { height: 36px; vertical-stretch: 0; text: AgentProviders.connected ? "Test and update" : "Test and connect"; enabled: !AgentProviders.busy && AgentProviders.tailscale-ready && lm-endpoint.text != ""; clicked => { AgentProviders.action(6, lm-endpoint.text); } }
                }
                if AgentProviders.connected && AgentProviders.active-index != AgentProviders.index-of(AgentProviders.provider): VerticalLayout {
                    alignment: start; spacing: 12px;
                    Button { height: 36px; vertical-stretch: 0; text: "Use " + AgentProviders.names[AgentProviders.index-of(AgentProviders.provider)] + " for Agent Angi"; enabled: !AgentProviders.busy; clicked => { AgentProviders.action(3, ""); } }
                    Text {
                        text: AgentProviders.active-index < 0 ? "Agent Angi builds with one service at a time." : "Agent Angi currently builds with " + AgentProviders.names[AgentProviders.active-index] + ". Using this service switches new builds to it.";
                        color: Theme.fg-dim; font-size: 11px; wrap: word-wrap;
                    }
                }
                if AgentProviders.connected && AgentProviders.active-index == AgentProviders.index-of(AgentProviders.provider): VerticalLayout {
                    alignment: start; spacing: 18px;
                    Text { text: "Models for new builds"; color: Theme.fg-bright; font-size: 17px; font-weight: 600; }
                    RoleModel { role: "os"; label: AgentProviders.provider == "openai" ? "OS updates / Chat" : "OS updates"; selected: AgentProviders.os-updates; index: AgentProviders.role-index[3]; }
                    Text {
                        text: AgentProviders.provider == "openai"
                            ? "This model handles Chat and changes to the desktop and system."
                            : "Changes to the desktop and system. One agent, no swarm, installs through angi-update.";
                        color: Theme.fg-dim; font-size: 11px; wrap: word-wrap;
                    }
                    Text { text: "Projects"; color: Theme.fg-bright; font-size: 14px; font-weight: 600; }
                    RoleModel { role: "orchestrator"; selected: AgentProviders.orchestrator; index: AgentProviders.role-index[0]; }
                    RoleModel { role: "builder"; selected: AgentProviders.builder; index: AgentProviders.role-index[1]; }
                    RoleModel { role: "tester"; selected: AgentProviders.tester; index: AgentProviders.role-index[2]; }
                    Text { text: "Each choice is saved immediately. Existing agent sessions keep their current models."; color: Theme.fg-dim; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
        Button { height: 36px; vertical-stretch: 0; text: "Refresh connection"; enabled: !AgentProviders.busy; clicked => { AgentProviders.action(0, ""); } }
    }
}
