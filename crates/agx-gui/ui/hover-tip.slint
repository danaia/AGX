import { Theme } from "data.slint";

export component HoverDwell inherits Rectangle {
    in property <bool> hovered;
    out property <bool> ready: false;
    width: 0px;
    height: 0px;
    changed hovered => {
        dwell.running = root.hovered;
        if !root.hovered { root.ready = false; }
    }
    public function dismiss() {
        dwell.running = false;
        root.ready = false;
    }
    dwell := Timer {
        interval: 400ms;
        running: false;
        triggered => { self.running = false; root.ready = root.hovered; }
    }
}

export component HoverTip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    visible: root.shown;
    width: 300px;
    height: words.preferred-height + 22px;
    background: Theme.bg-light;
    border-color: Theme.accent;
    border-width: 1px;
    border-radius: 8px;
    words := Text {
        x: 13px;
        y: 11px;
        width: max(0px, parent.width - 26px);
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.fg-bright;
        text: root.text;
    }
}
