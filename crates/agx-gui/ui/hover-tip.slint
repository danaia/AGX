import { Theme } from "data.slint";

// Tooltip shown after a short hover dwell. Same look as the Agent Angie scope tip (agent-scope.slint);
// the owner decides when it is `shown` and where it sits.
export component HoverTip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    visible: shown;
    width: 300px; height: words.preferred-height + 22px;
    background: Theme.bg-light; border-color: Theme.accent; border-width: 1px; border-radius: 8px;
    words := Text {
        x: 13px; y: 11px; width: parent.width - 26px; wrap: word-wrap; font-size: 12px; color: Theme.fg-bright;
        text: root.text;
    }
}
