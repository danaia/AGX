import { Theme } from "data.slint";
import { Button } from "std-widgets.slint";

// What Agent Angie builds: the operating system ("os") or one project folder ("project").
//
// The project folder arrives through two callbacks only:
//   choose-project()   the user asked to pick a folder; agent_project.rs opens ANGI Files' picker.
//   use-project(path)  a folder was chosen by any means. The agent runtime validates it.
export global AgentScope {
    in-out property <string> mode: "os";
    in-out property <string> project;
    in-out property <string> error;
    in-out property <bool> checking;
    out property <bool> ready: mode == "os" || project != "";
    callback choose-project();
    callback use-project(string);
}

// Two-segment switch. Hovering a segment for a moment raises `hint` (0 = OS, 1 = Project), which the
// panel turns into a tooltip beside it.
export component ModeSwitch inherits Rectangle {
    out property <int> hint: -1;
    width: 176px; height: 32px;
    border-radius: 8px; border-width: 1px; border-color: Theme.muted; background: Theme.bg-dark;
    for label[index] in ["OS", "Project"] : Rectangle {
        x: index * parent.width / 2; width: parent.width / 2; height: parent.height;
        property <bool> selected: (index == 0) == (AgentScope.mode == "os");
        border-radius: 7px; background: selected ? Theme.accent : transparent;
        Text { text: label; color: selected ? Theme.bg-dark : Theme.fg; font-size: 12px; font-weight: selected ? 700 : 400; }
        TouchArea {
            clicked => { AgentScope.mode = index == 0 ? "os" : "project"; root.hint = -1; }
            changed has-hover => {
                dwell.running = self.has-hover;
                if (!self.has-hover) { root.hint = -1; }
            }
        }
        dwell := Timer { interval: 400ms; running: false; triggered => { self.running = false; root.hint = index; } }
    }
}

export component ScopeTip inherits Rectangle {
    in property <int> hint;
    visible: hint >= 0;
    width: 330px; height: words.preferred-height + 22px;
    background: Theme.bg-light; border-color: Theme.accent; border-width: 1px; border-radius: 8px;
    words := Text {
        x: 13px; y: 11px; width: parent.width - 26px; wrap: word-wrap; font-size: 12px; color: Theme.fg-bright;
        text: root.hint == 1
            ? "Project: build your own software. Herdr's agents work only inside the folder you choose and leave the operating system alone."
            : "OS: you are extending the operating system. Herdr's agents focus strictly on ANGI itself: its source, services and desktop on this device.";
    }
}

// Shown in Project mode: the chosen folder and a button that opens the folder picker.
export component ProjectRow inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            horizontal-stretch: 1; height: 32px; border-radius: 6px; background: Theme.bg-dark;
            border-width: 1px; border-color: AgentScope.error != "" ? Theme.red : Theme.muted;
            Text {
                x: 10px; width: parent.width - 20px; vertical-alignment: center; overflow: elide; font-size: 12px;
                text: AgentScope.project != "" ? AgentScope.project : "No project folder selected";
                color: AgentScope.project != "" ? Theme.fg-bright : Theme.fg-dim;
            }
        }
        Button { height: 32px; vertical-stretch: 0; text: AgentScope.project != "" ? "Change…" : "Select folder…"; enabled: !AgentScope.checking; clicked => { AgentScope.choose-project(); } }
    }
    if AgentScope.error != "": Text { text: AgentScope.error; color: Theme.red; font-size: 12px; wrap: word-wrap; }
}
