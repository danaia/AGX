import { Theme } from "data.slint";

export global ChromiumView {
    in property <image> frame;
    in property <string> message;
}

export component ChromiumPanel inherits Rectangle {
    background: Theme.bg-dark;
    Image {
        width: parent.width;
        height: parent.height;
        source: ChromiumView.frame;
        image-fit: contain;
    }
    if ChromiumView.message != "": Text {
        text: ChromiumView.message;
        color: Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
