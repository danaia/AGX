import { Theme, Sys } from "data.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.fg-bright;
    spacing: 12px;
    Text { text: root.label; color: Theme.fg-dim; horizontal-stretch: 0; min-width: 96px; }
    Text { text: root.value; color: root.tint; overflow: elide; horizontal-stretch: 1; }
}

component Meter inherits VerticalLayout {
    in property <string> label;
    in property <float> percent;
    in property <string> detail;
    in property <color> tint: Theme.accent;
    spacing: 4px;
    alignment: start;
    max-height: 36px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.fg; font-weight: 700; }
        Text { text: root.detail; color: Theme.fg-dim; horizontal-alignment: right; overflow: elide; }
    }
    Rectangle {
        height: 10px;
        background: Theme.bg-light;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            background: root.percent > 85 ? Theme.red : root.percent > 65 ? Theme.yellow : root.tint;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component StateDot inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    background: state == "up" || state == "ready" || state == "present" || state == "running" ? Theme.green
        : state == "down" || state == "missing" || state == "failed" ? Theme.red : Theme.yellow;
}

export component OverviewPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    alignment: start;
    Image {
        source: @image-url("../../../brand/brand-mark-text.svg");
        width: min(200px, parent.width - 24px);
        height: self.width * 239 / 711;
        image-fit: contain;
        accessible-label: "ANGI";
    }
    Row { label: "host"; value: Sys.hostname; }
    Row { label: "board"; value: Sys.board; }
    Row { label: "kernel"; value: Sys.kernel; }
    Row { label: "uptime"; value: Sys.uptime; }
    Row { label: "address"; value: Sys.primary-ip; tint: Theme.green; }
}

export component CpuPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    alignment: start;
    Meter { label: "usage"; percent: Sys.cpu-percent; detail: Sys.cpu-detail; tint: Theme.cyan; }
    Row { label: "load"; value: Sys.load-text; }
}

export component MemoryPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    alignment: start;
    Meter { label: "memory"; percent: Sys.mem-percent; detail: Sys.mem-detail; tint: Theme.magenta; }
    Meter { label: "root"; percent: Sys.disk-percent; detail: Sys.disk-detail; tint: Theme.accent; }
}

export component NetworkPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 6px;
    alignment: start;
    for n in Sys.networks: HorizontalLayout {
        spacing: 12px;
        height: 24px;
        Rectangle { width: 8px; StateDot { state: n.state; } }
        Text { text: n.name; color: Theme.fg-bright; font-weight: 700; width: 110px; vertical-alignment: center; }
        Text { text: n.state; color: Theme.fg-dim; width: 90px; vertical-alignment: center; }
        Text { text: n.ipv4; color: Theme.green; width: 160px; vertical-alignment: center; }
        Text { text: n.mac; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; }
    }
    Text { text: "Wi-Fi setup: open the menu and choose Open TUI."; color: Theme.fg-dim; font-size: 12px; }
}

export component HardwarePanel inherits VerticalLayout {
    padding: 12px;
    spacing: 6px;
    alignment: start;
    for h in Sys.hardware: HorizontalLayout {
        spacing: 12px;
        height: 24px;
        Rectangle { width: 8px; StateDot { state: h.state; } }
        Text { text: h.kind; color: Theme.accent; width: 90px; vertical-alignment: center; }
        Text { text: h.name; color: Theme.fg-bright; width: 170px; vertical-alignment: center; }
        Text { text: h.detail; color: Theme.fg-dim; overflow: elide; vertical-alignment: center; }
    }
}

export component ServicesPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    alignment: start;
    Text { text: "Service supervision is not wired into the GUI yet."; color: Theme.yellow; wrap: word-wrap; }
    Text {
        text: "Use `agx services status` or the TUI Services tab.";
        color: Theme.fg-dim;
        wrap: word-wrap;
    }
}

export component SystemPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    alignment: start;
    Row { label: "kernel"; value: Sys.kernel; }
    Row { label: "board"; value: Sys.board; }
    Row { label: "uptime"; value: Sys.uptime; }
    Row { label: "warnings"; value: Sys.warnings == "" ? "none" : Sys.warnings; tint: Sys.warnings == "" ? Theme.green : Theme.yellow; }
    Row { label: "display"; value: Sys.mode-note; }
    Row { label: "screen"; value: Sys.screen-size; }
}
