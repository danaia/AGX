import { Theme, Sys } from "data.slint";
import { StorageMap, StorageView } from "storage.slint";
import { MemoryProcesses } from "memory-processes.slint";
import { DesktopInput } from "desktop-input.slint";
import { ScrollView, Button } from "std-widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.fg-bright;
    spacing: 12px;
    Text { text: root.label; color: Theme.fg-dim; horizontal-stretch: 0; min-width: 96px; }
    Text { text: root.value; color: root.tint; overflow: elide; horizontal-stretch: 1; }
}

component Meter inherits VerticalLayout {
    in property <string> label;
    in property <float> percent;
    in property <string> detail;
    in property <color> tint: Theme.accent;
    spacing: 4px;
    alignment: start;
    max-height: 36px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.fg; font-weight: 700; }
        Text { text: root.detail; color: Theme.fg-dim; horizontal-alignment: right; overflow: elide; }
    }
    Rectangle {
        height: 10px;
        background: Theme.bg-light;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            background: root.percent > 85 ? Theme.red : root.percent > 65 ? Theme.yellow : root.tint;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component StateDot inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    background: state == "up" || state == "ready" || state == "present" || state == "running" ? Theme.green
        : state == "down" || state == "missing" || state == "failed" ? Theme.red : Theme.yellow;
}

export component OverviewPanel inherits Rectangle {
    in property <int> cursor;
    in property <bool> hide-cursor;
    callback pointer(int, int, length, length, bool, bool, bool, bool);
    callback pointer-moved(length, length);
    DesktopInput {
        cursor: root.cursor;
        hide-cursor: root.hide-cursor;
        pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    HorizontalLayout {
        x: 12px; y: 12px;
        width: max(0px, root.width - 54px); height: 112px;
        spacing: 12px;
        VerticalLayout {
            spacing: 3px;
            Row { label: "host"; value: Sys.hostname; }
            Row { label: "board"; value: Sys.board; }
            Row { label: "kernel"; value: Sys.kernel; }
            Row { label: "uptime"; value: Sys.uptime; }
            Row { label: "address"; value: Sys.primary-ip; tint: Theme.green; }
        }
        Image {
            source: @image-url("../../../brand/brand-mark-text.svg");
            width: root.width > 600px ? 170px : 100px;
            image-fit: contain;
            accessible-label: "ANGI";
        }
    }
    Rectangle { x: 12px; y: 134px; width: max(0px, root.width - 24px); height: 1px; background: #3d3030; }
    ScrollView {
        x: 0px; y: 135px;
        width: parent.width; height: max(0px, parent.height - 179px);
        content-width: self.width;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        VerticalLayout {
            padding: 12px;
            padding-top: 10px;
            spacing: 10px;
            alignment: start;
            sd-map := StorageMap {
                label: "SD card"; drive: 0;
                summary: StorageView.sd-summary;
                status: StorageView.sd-status;
                cells: StorageView.sd-cells;
                cursor: root.cursor; hide-cursor: root.hide-cursor;
                pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
            nvme-map := StorageMap {
                label: "NVMe"; drive: 1;
                summary: StorageView.nvme-summary;
                status: StorageView.nvme-status;
                cells: StorageView.nvme-cells;
                cursor: root.cursor; hide-cursor: root.hide-cursor;
                pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
            Text { text: "Your files ≥ 1 MiB · green < 10 MiB · amber 100 MiB · red ≥ 1 GiB · click for details"; color: #947a6d; font-size: 10px; wrap: word-wrap; }

        }
    }
    if sd-map.hover-path != "" || nvme-map.hover-path != "": Rectangle {
        x: 12px; y: max(0px, root.height - 40px);
        width: max(0px, root.width - 192px); height: 32px;
        VerticalLayout {
            spacing: 2px;
            Text { text: sd-map.hover-path != "" ? sd-map.hover-path : nvme-map.hover-path; color: Theme.fg; font-size: 11px; overflow: elide; }
            Text { text: sd-map.hover-path != "" ? sd-map.hover-detail : nvme-map.hover-detail; color: Theme.fg-dim; font-size: 10px; overflow: elide; }
        }
    }
    Button {
        x: max(0px, root.width - self.width - 56px);
        y: max(0px, root.height - self.height - 8px);
        width: 124px; height: 32px;
        text: "Clear cache…";
        enabled: !StorageView.selected-open;
        clicked => { StorageView.check-cache(); }
    }
    Button {
        x: max(0px, root.width - self.width - 8px);
        y: max(0px, root.height - self.height - 8px);
        width: 40px; height: 32px;
        icon: @image-url("icons/refresh.svg");
        icon-size: 16px;
        colorize-icon: true;
        accessible-label: StorageView.refreshing ? "Refreshing files" : "Refresh files";
        enabled: !StorageView.selected-open && !StorageView.refreshing;
        clicked => { StorageView.refresh-files(); }
    }
}

export component CpuPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    alignment: start;
    Meter { label: "usage"; percent: Sys.cpu-percent; detail: Sys.cpu-detail; tint: Theme.cyan; }
    Row { label: "load"; value: Sys.load-text; }
}

export component MemoryPanel inherits VerticalLayout {
    callback pointer-moved(length, length);
    padding: 12px;
    spacing: 10px;
    alignment: start;
    Rectangle {
        height: 36px;
        accessible-role: button;
        accessible-label: "Memory usage. Show processes";
        Meter { label: "memory"; percent: Sys.mem-percent; detail: Sys.mem-detail; tint: Theme.magenta; }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            moved => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            clicked => { MemoryProcesses.show(); }
        }
    }
    Meter { label: "root"; percent: Sys.disk-percent; detail: Sys.disk-detail; tint: Theme.accent; }
}

export component NetworkPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 6px;
    alignment: start;
    for n in Sys.networks: HorizontalLayout {
        spacing: 12px;
        height: 24px;
        Rectangle { width: 8px; StateDot { state: n.state; } }
        Text { text: n.name; color: Theme.fg-bright; font-weight: 700; width: 110px; vertical-alignment: center; }
        Text { text: n.state; color: Theme.fg-dim; width: 90px; vertical-alignment: center; }
        Text { text: n.ipv4; color: Theme.green; width: 160px; vertical-alignment: center; }
        Text { text: n.mac; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; }
    }
    Text { text: "Wi-Fi setup: open the menu and choose Open TUI."; color: Theme.fg-dim; font-size: 12px; }
}

export component HardwarePanel inherits VerticalLayout {
    padding: 12px;
    spacing: 6px;
    alignment: start;
    for h in Sys.hardware: HorizontalLayout {
        spacing: 12px;
        height: 24px;
        Rectangle { width: 8px; StateDot { state: h.state; } }
        Text { text: h.kind; color: Theme.accent; width: 90px; vertical-alignment: center; }
        Text { text: h.name; color: Theme.fg-bright; width: 170px; vertical-alignment: center; }
        Text { text: h.detail; color: Theme.fg-dim; overflow: elide; vertical-alignment: center; }
    }
}

export component ServicesPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    alignment: start;
    Text { text: "Service supervision is not wired into the GUI yet."; color: Theme.yellow; wrap: word-wrap; }
    Text {
        text: "Use `agx services status` or the TUI Services tab.";
        color: Theme.fg-dim;
        wrap: word-wrap;
    }
}

export component SystemPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    alignment: start;
    Row { label: "kernel"; value: Sys.kernel; }
    Row { label: "board"; value: Sys.board; }
    Row { label: "uptime"; value: Sys.uptime; }
    Row { label: "warnings"; value: Sys.warnings == "" ? "none" : Sys.warnings; tint: Sys.warnings == "" ? Theme.green : Theme.yellow; }
    Row { label: "display"; value: Sys.mode-note; }
    Row { label: "screen"; value: Sys.screen-size; }
}
